        "pages": [
          "settings/position-size",
          "settings/symbol-mapping",
          "settings/orders",
          "settings/symbol-filter",
          "settings/account-protection"
        ]
      },
      {
        "group": "Using the dashboard",
        "pages": [
          "dashboard/overview",
          "dashboard/managing-accounts",
          "dashboard/logs",
          "dashboard/journal",
          "dashboard/account-settings"
        ]
      },
      {
